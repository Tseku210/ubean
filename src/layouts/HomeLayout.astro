---
import Header from "@/components/Header.astro";
import "../styles/global.css";
import "@fontsource/ubuntu/300.css";
import "@fontsource/ubuntu";
import "@fontsource/ubuntu/400-italic.css";
import "@fontsource/ubuntu/500.css";
import Head from "@/components/Head.astro";
import Footer from "@/components/Footer.astro";
import { getLangFromUrl } from "@/i18n/utils";
import { getDescription, getKeywords } from "@/lib/seo";
import SpeedInsights from "@vercel/speed-insights/astro";

export interface Props {
  title: string;
  description?: string;
  keywords?: string;
  image?: string;
}

const lang = getLangFromUrl(Astro.url);
const siteDescription = getDescription(lang);
const siteKeywords = getKeywords(lang);

const {
  title,
  description = siteDescription,
  keywords = siteKeywords,
  image = "/images/where-the-aroma-begins.webp",
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <Head
      title={title}
      description={description}
      keywords={keywords}
      image={image}
    />
  </head>
  <body class="w-screen">
    <SpeedInsights />
    <div
      id="smooth-wrapper"
      class="font-ubuntu text-secondary bg-white bg-[url('/images/bg.webp')]"
    >
      <div id="smooth-content" class="container mx-auto max-w-[1440px]">
        <div>
          <Header />
          <slot />
          <Footer />
        </div>
      </div>
    </div>
  </body>
</html>
