---
import { Button } from "@/components/ui/button";
import type { languages } from "@/i18n/ui";
import { useTranslatedPath, useTranslations } from "@/i18n/utils";
import { Category } from "@/types";

interface Props {
  category: Category;
  lang: keyof typeof languages;
}

const { category, lang } = Astro.props;
const t = useTranslations(lang);
const translatedPath = useTranslatedPath(lang);
---

<div class="no-scrollbar w-full overflow-x-auto">
  <div
    class="flex w-fit snap-x gap-2 first:pl-8 last:pr-8 md:first:pl-0 md:last:pr-0"
  >
    <a
      class="shrink-0 snap-start"
      href={translatedPath(`/menu/${Category.coffee}/`)}
      data-astro-prefetch
      transition:name="category-pill-coffee"
    >
      <Button
        variant={category === Category.coffee ? "secondary" : "ghost"}
        size="sm"
        data-category={Category.coffee}
        className="md:w-full"
      >
        {t("menu.coffee")}
      </Button>
    </a>
    <a
      class="shrink-0 snap-start"
      href={translatedPath(`/menu/${Category.nonCoffee}/`)}
      data-astro-prefetch
      transition:name="category-pill-non-coffee"
    >
      <Button
        variant={category === Category.nonCoffee ? "secondary" : "ghost"}
        size="sm"
        data-category={Category.nonCoffee}
        className="category-button md:w-full"
      >
        {t("menu.non-coffee")}
      </Button>
    </a>
    <a
      class="shrink-0 snap-start"
      href={translatedPath(`/menu/${Category.specialty}/`)}
      data-astro-prefetch
      transition:name="category-pill-specialty"
    >
      <Button
        variant={category === Category.specialty ? "secondary" : "ghost"}
        size="sm"
        data-category={Category.specialty}
        className="category-button md:w-full"
      >
        {t("menu.specialty")}
      </Button>
    </a>
    <a
      class="shrink-0 snap-start"
      href={translatedPath(`/menu/${Category.grub}/`)}
      data-astro-prefetch
      transition:name="category-pill-grub"
    >
      <Button
        variant={category === Category.grub ? "secondary" : "ghost"}
        size="sm"
        data-category={Category.grub}
        className="category-button md:w-full"
      >
        {t("menu.grub")}
      </Button>
    </a>
  </div>
</div>
