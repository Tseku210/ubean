---
import type { SanityDocument } from "@sanity/client";
import { sanityClient } from "sanity:client";
import MenuItem from "./MenuItem.astro";
import { Category } from "@/types";
import type { languages } from "@/i18n/ui";
import { useTranslations } from "@/i18n/utils";

interface Props {
  category: Category;
  lang: keyof typeof languages;
}

const { category, lang } = Astro.props;

const t = useTranslations(lang);

const MENU_ITEMS_QUERY = `*[_type == "menuItem" && category == $category && available == true] | order(nameEn asc) {
  _id,
  nameEn,
  nameMn,
  category,
  image,
  prices {
    default,
    small,
    large
  },
  variants[] {
    nameEn,
    nameMn
  }
}`;

// This runs at build time (the menu is prerendered). A failed fetch must fail
// the build — swallowing it would bake a permanent error page into the deploy,
// while a failed build keeps the last good deployment live.
let menuItems: SanityDocument[] = [];
try {
  menuItems = await sanityClient.fetch<SanityDocument[]>(MENU_ITEMS_QUERY, {
    category,
  });
} catch (error) {
  console.error("Menu fetch failed:", error);
  throw error;
}
---

{
  menuItems.length === 0 ? (
    <p class="text-b1 py-12 text-center">{t("menu.empty")}</p>
  ) : (
    <div class="grid grid-cols-2 items-stretch gap-x-4 gap-y-8 md:grid-cols-4 md:gap-x-8 md:gap-y-16">
      {menuItems.map((item) => (
        <div class="h-full">
          <MenuItem menuItem={item} lang={lang} />
        </div>
      ))}
    </div>
  )
}
