---
import {
  getLangFromUrl,
  useTranslations,
  useTranslatedPath,
} from "@/i18n/utils";
import Logo from "../assets/icons/logo.svg";
import LanguagePicker from "./LanguagePicker.astro";
import MobileMenu from "./ui/MobileMenu";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const navLinks = {
  [t("nav.home")]: translatePath("/"),
  [t("nav.menu")]: translatePath("/menu/coffee/"),
  [t("nav.about")]: translatePath("/about-us/"),
  [t("nav.contact")]: translatePath("/contact/"),
};
---

<nav
  class="grid h-[90px] grid-cols-2 items-center px-4 py-4 md:grid-cols-[1fr_2fr_1fr] md:px-14"
>
  <a href="/">
    <Logo class="w-[121px] justify-self-start md:w-auto" />
  </a>
  <div class="hidden justify-center md:flex">
    <div
      class="text-h7 max-w-2xl items-center justify-between gap-12 uppercase md:flex"
    >
      {
        Object.entries(navLinks).map(([label, href]) => (
          <a href={href} data-astro-prefetch>
            {label}
          </a>
        ))
      }
    </div>
  </div>
  <div class="flex items-center gap-6 justify-self-end">
    <LanguagePicker />
    <MobileMenu navLinks={navLinks} client:load />
  </div>
</nav>
