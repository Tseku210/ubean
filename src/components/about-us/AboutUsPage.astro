---
import Layout from "@/layouts/Layout.astro";
import Smoke from "@assets/icons/smoke.svg";
import Line from "@assets/icons/line.svg";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title={`UBean - ${t("aboutus.title")}`}>
  <main
    class="mx-8 mt-10 flex min-h-[calc(100vh-74px-122px)] max-w-4xl flex-col items-center gap-6 md:mx-auto md:gap-10"
  >
    <div class="animate flex flex-col items-center gap-8">
      <Smoke width={100} />
      <h1 class="text-h4 md:text-h3 uppercase">
        {t("aboutus.ourstory.title")}
      </h1>
    </div>
    <div class="space-y-6 md:space-y-10">
      <div
        class="animate aspect-[3/2] overflow-hidden rounded-[40px] md:aspect-[2/1]"
      >
        <img
          src="/images/aboutus-1.webp"
          class="size-full object-cover"
        />
      </div>
      <p
        class="animate text-b3 md:text-b1 mx-auto max-w-3xl px-2 text-center md:px-0"
      >
        {t("aboutus.ourstory.desc")}
      </p>
    </div>
    <Line />
    <div
      class="flex flex-col items-center gap-6 md:w-[calc(100%-200px)] md:gap-16"
    >
      <div class="max-w-xl space-y-6 text-center">
        <h2 class="animate text-h5 md:text-h4 uppercase">
          {t("aboutus.ourvision.title")}
        </h2>
        <p class="animate text-b3 md:text-b1 mx-auto max-w-3xl px-2 md:px-0">
          {t("aboutus.ourvision.desc")}
        </p>
      </div>
      <div
        class="animate aspect-[3/2] overflow-hidden rounded-[40px] md:aspect-[2/1]"
      >
        <img
          src="/coffee-brew.webp"
          class="size-full origin-center object-cover"
        />
      </div>
    </div>
    <Line />
    <div
      class="flex flex-col items-center gap-6 md:mb-16 md:w-[calc(100%-200px)] md:gap-16"
    >
      <div class="max-w-xl space-y-6 text-center">
        <h2 class="animate text-h5 md:text-h4 uppercase">
          {t("aboutus.ourmission.title")}
        </h2>
        <p class="animate text-b3 md:text-b1 mx-auto max-w-3xl px-2 md:px-0">
          {t("aboutus.ourmission.desc")}
        </p>
      </div>
      <div
        class="animate aspect-[3/2] overflow-hidden rounded-[40px] md:aspect-[2/1]"
      >
        <img
          src="/images/aboutus-2.webp"
          class="size-full object-cover"
        />
      </div>
    </div>
  </main>
</Layout>
