---
import Layout from "@/layouts/Layout.astro";
import { Image } from "astro:assets";
import ContactImage from "@assets/images/contact.webp";
import PhoneIcon from "@assets/icons/phone.svg";
import ContactForm from "@/components/contact/ContactForm";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title={`UBean - ${t("contact.title")}`}>
  <main
    class="mx-8 mt-10 flex min-h-[calc(100vh-74px-122px)] max-w-4xl items-center md:mx-auto md:mt-0"
  >
    <div
      class="grid w-full grid-cols-1 justify-items-center gap-10 md:grid-cols-2 md:gap-16"
    >
      <div
        class="animate group order-2 w-full self-center overflow-hidden rounded-4xl transition-shadow hover:shadow-xl md:order-1 md:aspect-[4/5]"
      >
        <Image
          src={ContactImage}
          alt="Contact Us"
          class="size-full object-cover transition-transform group-hover:scale-105"
          layout="constrained"
          width={400}
        />
      </div>
      <section
        class="animate order-1 flex w-full max-w-md flex-col items-center justify-center gap-6 md:order-2"
      >
        <h2 class="text-h4 uppercase">{t("contact.contact")}</h2>
        <div class="flex gap-4">
          <PhoneIcon />
          <span class="text-b1">99837165, 86038620, 99590593</span>
        </div>
        <ContactForm lang={lang} client:only="react" />
      </section>
    </div>
  </main>
</Layout>
