---
import { getLangFromUrl, useTranslations } from "@/i18n/utils";
import Logo from "@/assets/icons/logo.svg";
import Facebook from "@/assets/icons/facebook.svg";
import Instagram from "@/assets/icons/instagram.svg";
import BackToTop from "@/components/BackToTop.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<footer
  class="mt-14 grid h-[100px] grid-cols-2 grid-rows-2 items-center px-8 md:mt-10 md:gap-4 md:px-14 lg:mt-auto lg:grid-cols-3 lg:grid-rows-1"
>
  <Logo class="order-1 md:h-10 md:w-38" width={121} height={34} />
  <span
    class="text-b4 order-3 col-span-2 justify-self-center select-none lg:order-2 lg:col-span-1"
    >{t("footer.allrights")}</span
  >
  <div
    class="order-2 flex items-center gap-6 justify-self-end md:gap-4 lg:order-3"
  >
    <a
      href="https://www.facebook.com/ubeancoffeehouseandroasterie"
      class="transition-transform duration-200 ease-out hover:-translate-y-1"
    >
      <Facebook />
    </a>
    <a
      href="https://www.instagram.com/ubeancoffee/"
      class="transition-transform duration-200 ease-out hover:-translate-y-1"
    >
      <Instagram />
    </a>
    <div class="hidden md:block">
      <BackToTop text={t("footer.backtotop")} />
    </div>
  </div>
</footer>
