---
import "../styles/global.css";
import { Font } from "astro:assets";
import { getLangFromUrl } from "@/i18n/utils";

interface Props {
  title: string;
  description: string;
  image?: string;
  keywords?: string;
  author?: string;
  canonicalURL?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  image = "/images/aboutus-2.webp",
  keywords,
  author = "UBean",
  canonicalURL = new URL(Astro.url.pathname, Astro.site).href,
  noindex = false,
} = Astro.props;

const siteName = "UBean Roastery Shop";
const fullTitle = title.includes(siteName) ? title : `${title} | ${siteName}`;

const lang = getLangFromUrl(Astro.url);

// hreflang alternates. English pages live at `/x`, Mongolian at `/mn/x`.
const path = Astro.url.pathname.replace(/^\/mn(?=\/|$)/, "") || "/";
const enUrl = new URL(path, Astro.site).href;
const mnUrl = new URL(`/mn${path === "/" ? "" : path}`, Astro.site).href;

const localized = {
  en: {
    description: "Premium coffee beans and expertly crafted beverages",
    servesCuisine: ["Coffee", "Bakery"],
    streetAddress:
      "Nam Yan Ju St БЗД, 13-р хороолол Mongol NamYanJu Cultural Center (Across from the Night Market), 2nd Floor Монгол Намянжүгийн Соёлын төв (шөнийн захын эсрэг талд), 2-р давхар, Ulaanbaatar, Mongolia",
    addressLocality: "Ulaanbaatar",
    url: new URL("/", Astro.site).href,
    hasMenu: new URL("/menu/coffee", Astro.site).href,
  },
  mn: {
    description: "Дээд зэрэглэлийн кофе болон кофены үрийг нэг дор.",
    servesCuisine: ["Кофе", "Бейкери"],
    streetAddress:
      "Нам Ян Жү гудамж, БЗД, 13-р хороолол, Монгол Намянжү Соёлын төв (Шөнийн захын эсрэг талд), 2-р давхар",
    addressLocality: "Улаанбаатар",
    url: new URL("/mn", Astro.site).href,
    hasMenu: new URL("/mn/menu/coffee", Astro.site).href,
  },
}[lang];

const structuredData = {
  "@context": "https://schema.org",
  "@type": "CafeOrCoffeeShop",
  "@id": new URL("/#coffee-shop", Astro.site).href,
  name: siteName,
  description: localized.description,
  url: localized.url,
  logo: new URL("/images/logo.webp", Astro.site).href,
  image: [
    new URL("/images/aboutus-1.webp", Astro.site).href,
    new URL("/images/aboutus-2.webp", Astro.site).href,
  ],
  telephone: "+97686038620",
  servesCuisine: localized.servesCuisine,
  priceRange: "$",
  inLanguage: lang,
  address: {
    "@type": "PostalAddress",
    streetAddress: localized.streetAddress,
    addressLocality: localized.addressLocality,
    addressCountry: "MN",
  },
  openingHoursSpecification: [
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      opens: "07:30",
      closes: "21:00",
    },
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Saturday"],
      opens: "09:00",
      closes: "20:00",
    },
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Sunday"],
      opens: "15:30",
      closes: "19:00",
    },
  ],
  sameAs: [
    "https://www.facebook.com/ubeancoffeehouseandroasterie",
    "https://www.instagram.com/ubeancoffee",
  ],
  hasMenu: localized.hasMenu,
};
---

<!-- Basic Meta Tags -->
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="description" content={description} />
{keywords && <meta name="keywords" content={keywords} />}
{author && <meta name="author" content={author} />}
<meta name="generator" content={Astro.generator} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<!-- Title -->
<title>{fullTitle}</title>

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Locale alternates -->
<link rel="alternate" hreflang="en" href={enUrl} />
<link rel="alternate" hreflang="mn" href={mnUrl} />
<link rel="alternate" hreflang="x-default" href={enUrl} />

<!-- Favicon -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

<!-- Fonts -->
<Font cssVariable="--font-ubuntu" preload />
<Font cssVariable="--font-roboto" preload />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.site).href} />
<meta property="og:site_name" content={siteName} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={fullTitle} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(image, Astro.site).href} />

<!-- Additional SEO -->
<meta name="theme-color" content="#8B4513" />
<meta name="format-detection" content="telephone=no" />

<!-- JSON-LD Structured Data -->
<script
  type="application/ld+json"
  is:inline
  set:html={JSON.stringify(structuredData)}
/>

<script is:inline>
  function init() {
    onScroll();
    animate();

    const backToTop = document.getElementById("back-to-top");
    backToTop?.addEventListener("click", (event) => scrollToTop(event));

    const backToPrev = document.getElementById("back-to-prev");
    backToPrev?.addEventListener("click", () => window.history.back());

    document.addEventListener("scroll", onScroll);
  }

  function animate() {
    const animateElements = document.querySelectorAll(".animate");

    animateElements.forEach((element, index) => {
      setTimeout(() => {
        element.classList.add("show");
      }, index * 150);
    });
  }

  function onScroll() {
    if (window.scrollY > 0) {
      document.documentElement.classList.add("scrolled");
    } else {
      document.documentElement.classList.remove("scrolled");
    }
  }

  function scrollToTop(event) {
    event.preventDefault();
    window.scrollTo({
      top: 0,
      behavior: "smooth",
    });
  }

  document.addEventListener("DOMContentLoaded", () => init());
  document.addEventListener("astro:after-swap", () => init());
</script>
