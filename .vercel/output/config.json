{
	"version": 3,
	"routes": [
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"src": "^/_server-islands/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/_image/?$",
			"dest": "_render"
		},
		{
			"src": "^/404/?$",
			"dest": "_render"
		},
		{
			"src": "^/about-us/?$",
			"dest": "_render"
		},
		{
			"src": "^/admin(?:/(.*?))?/?$",
			"dest": "_render"
		},
		{
			"src": "^/contact/?$",
			"dest": "_render"
		},
		{
			"src": "^/menu/coffee/?$",
			"dest": "_render"
		},
		{
			"src": "^/menu/grub/?$",
			"dest": "_render"
		},
		{
			"src": "^/menu/non-coffee/?$",
			"dest": "_render"
		},
		{
			"src": "^/menu/specialty/?$",
			"dest": "_render"
		},
		{
			"src": "^/mn/about-us/?$",
			"dest": "_render"
		},
		{
			"src": "^/mn/contact/?$",
			"dest": "_render"
		},
		{
			"src": "^/mn/menu/coffee/?$",
			"dest": "_render"
		},
		{
			"src": "^/mn/menu/grub/?$",
			"dest": "_render"
		},
		{
			"src": "^/mn/menu/non-coffee/?$",
			"dest": "_render"
		},
		{
			"src": "^/mn/menu/specialty/?$",
			"dest": "_render"
		},
		{
			"src": "^/mn/?$",
			"dest": "_render"
		},
		{
			"src": "^/$",
			"dest": "_render"
		},
		{
			"src": "^/.*$",
			"dest": "_render",
			"status": 404
		}
	]
}